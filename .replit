modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["npm", "run", "deploy:build"]
run = ["node", "script/replit-fast-start.mjs"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5012
externalPort = 3000

[env]
CEO_PAUSED_DOMAINS = "websites,dropshipping"
PORT = "5000"
PUBLIC_BASE_URL = "https://robplanner.replit.app"
OFFICE_WORKER_ENABLED = "false"
OFFICE_KONG_AUDIT_SCHEDULE_ENABLED = "false"

KONG_REPAIR_BRIDGE_ENABLED = "true"
KONG_REPAIR_PULL_ENABLED = "true"
KONG_REPAIR_HANDOFF_ENABLED = "true"
KONG_REPAIR_CHECKER_ENGINE_COMMIT = "2cd06ec20c0479cdf2d8765bdf231e22831e5293"
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"
integrations = ["google-calendar:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0", "github:1.0.0"]
expertMode = true

[userenv]

[userenv.shared]
DEFAULT_USER_ID = "mock-user-123"
OFFICE_WEB_REVISION = "142da2354504ab22f722ec8bdc640048962e0db1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-2d342fb0-d15f-4263-b84c-751093635101"
